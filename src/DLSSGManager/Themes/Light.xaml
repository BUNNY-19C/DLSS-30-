<!--
    浅色主题。键与 Dark.xaml 完全一致——切换时整个字典被替换，
    少一个键就会在切换后出现找不到资源的错误。

    状态色与强调色都比深色版更深：同样的绿/橙直接用在白底上对比度不足，
    文字和状态点会发虚。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 窗口与容器 -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F4F5F7" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackground" Color="#F0F2F5" />
    <SolidColorBrush x:Key="LogBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBackground" Color="#FFFFFF" />

    <!-- 输入控件 -->
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#C6CAD2" />

    <!-- 分隔线与悬停 -->
    <SolidColorBrush x:Key="LineBrush" Color="#DFE1E6" />
    <SolidColorBrush x:Key="HoverBackground" Color="#E8EAEE" />
    <SolidColorBrush x:Key="ListHoverBackground" Color="#EDEFF3" />
    <SolidColorBrush x:Key="ListSelectedBackground" Color="#D8E5FA" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#1B1F26" />
    <SolidColorBrush x:Key="TextMuted" Color="#5A616B" />
    <SolidColorBrush x:Key="TextFaint" Color="#868D98" />
    <SolidColorBrush x:Key="TextSection" Color="#525A66" />
    <SolidColorBrush x:Key="TextLogTitle" Color="#3C434D" />
    <SolidColorBrush x:Key="TextOnLog" Color="#2A3038" />

    <!-- 强调色与按钮 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1A66D6" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C6CAD2" />
    <SolidColorBrush x:Key="PrimaryBackground" Color="#1A66D6" />
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#1A66D6" />
    <SolidColorBrush x:Key="PrimaryHoverBackground" Color="#1557B8" />
    <SolidColorBrush x:Key="OnPrimaryText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBackground" Color="#FDF0F0" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#E6B9B9" />
    <SolidColorBrush x:Key="DangerText" Color="#A81E17" />

    <!-- 徽章 -->
    <SolidColorBrush x:Key="BadgeOkBackground" Color="#E1F3E1" />
    <SolidColorBrush x:Key="BadgeOkText" Color="#26601F" />
    <SolidColorBrush x:Key="BadgeWarnBackground" Color="#FCEFDB" />
    <SolidColorBrush x:Key="BadgeWarnText" Color="#8A5606" />

    <!-- 反作弊警告横幅 -->
    <SolidColorBrush x:Key="WarnBannerBackground" Color="#FFF6E5" />
    <SolidColorBrush x:Key="WarnBannerBorder" Color="#EFD3A0" />
    <SolidColorBrush x:Key="WarnBannerTitle" Color="#7D5000" />
    <SolidColorBrush x:Key="WarnBannerBody" Color="#66491F" />

    <!-- 游戏状态指示 -->
    <SolidColorBrush x:Key="StatusOkBrush" Color="#2C7A2C" />
    <SolidColorBrush x:Key="StatusWarnBrush" Color="#9C5800" />
    <SolidColorBrush x:Key="StatusBadBrush" Color="#BE251D" />
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#767D88" />

</ResourceDictionary>
