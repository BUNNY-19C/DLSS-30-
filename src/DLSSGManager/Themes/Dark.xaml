<!--
    深色主题。

    界面用 DynamicResource 查找这些键，切换主题时整个字典被替换，
    WPF 会重新解析所有引用——不需要重建窗口。

    为什么必须是 DynamicResource 而不是 StaticResource：
    StaticResource 在元素创建时解析一次，之后不再查表，所以切换主题
    会让大部分界面停留在旧颜色上。

    键按用途命名，不按颜色命名，这样浅色主题能用完全不同的色值表达
    同一语义。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 窗口与容器 -->
    <SolidColorBrush x:Key="WindowBackground" Color="#12141A" />
    <SolidColorBrush x:Key="PanelBackground" Color="#1A1D25" />
    <SolidColorBrush x:Key="CardBackground" Color="#22262F" />
    <SolidColorBrush x:Key="LogBackground" Color="#0E1015" />
    <SolidColorBrush x:Key="PopupBackground" Color="#1A1D25" />

    <!-- 输入控件 -->
    <SolidColorBrush x:Key="InputBackground" Color="#15181F" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#333944" />

    <!-- 分隔线与悬停 -->
    <SolidColorBrush x:Key="LineBrush" Color="#2E333D" />
    <SolidColorBrush x:Key="HoverBackground" Color="#353B48" />
    <SolidColorBrush x:Key="ListHoverBackground" Color="#252A33" />
    <SolidColorBrush x:Key="ListSelectedBackground" Color="#2C3A55" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E6E8EC" />
    <SolidColorBrush x:Key="TextMuted" Color="#9AA0A6" />
    <SolidColorBrush x:Key="TextFaint" Color="#6E7681" />
    <SolidColorBrush x:Key="TextSection" Color="#8B93A1" />
    <SolidColorBrush x:Key="TextLogTitle" Color="#B9C0CC" />
    <SolidColorBrush x:Key="TextOnLog" Color="#C6CDD8" />

    <!-- 强调色与按钮 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#2A2F3A" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3A414D" />
    <SolidColorBrush x:Key="PrimaryBackground" Color="#2F6FE4" />
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#4C8DFF" />
    <SolidColorBrush x:Key="PrimaryHoverBackground" Color="#3D7DF2" />
    <SolidColorBrush x:Key="OnPrimaryText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBackground" Color="#3A2A2A" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#5C3A3A" />
    <SolidColorBrush x:Key="DangerText" Color="#FFB4B4" />

    <!-- 徽章 -->
    <SolidColorBrush x:Key="BadgeOkBackground" Color="#2A3A2A" />
    <SolidColorBrush x:Key="BadgeOkText" Color="#9BD69B" />
    <SolidColorBrush x:Key="BadgeWarnBackground" Color="#3A2F1A" />
    <SolidColorBrush x:Key="BadgeWarnText" Color="#FFC46B" />

    <!-- 反作弊警告横幅 -->
    <SolidColorBrush x:Key="WarnBannerBackground" Color="#3A2A1A" />
    <SolidColorBrush x:Key="WarnBannerBorder" Color="#6B4A1A" />
    <SolidColorBrush x:Key="WarnBannerTitle" Color="#FFC46B" />
    <SolidColorBrush x:Key="WarnBannerBody" Color="#D9B98A" />

    <!-- 游戏状态指示 -->
    <SolidColorBrush x:Key="StatusOkBrush" Color="#4C9A2A" />
    <SolidColorBrush x:Key="StatusWarnBrush" Color="#C77700" />
    <SolidColorBrush x:Key="StatusBadBrush" Color="#C62828" />
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#9AA0A6" />

</ResourceDictionary>
