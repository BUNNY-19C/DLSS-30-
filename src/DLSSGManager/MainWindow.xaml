<Window x:Class="DLSSGManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DLSSGManager"
        xmlns:loc="clr-namespace:DLSSGManager"
        Title="{loc:Tr App.Name}" Height="820" Width="1240" MinHeight="640" MinWidth="1040"
        Background="#12141A" Foreground="#E6E8EC"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">

    <Window.Resources>
        <local:BoolToVisibility x:Key="BoolToVis" />
        <local:NotEmptyToVisibility x:Key="NotEmptyToVis" />

        <SolidColorBrush x:Key="PanelBrush" Color="#1A1D25" />
        <SolidColorBrush x:Key="CardBrush" Color="#22262F" />
        <SolidColorBrush x:Key="LineBrush" Color="#2E333D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA0A6" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E8EC" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8B93A1" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#15181F" />
            <Setter Property="Foreground" Value="#E6E8EC" />
            <Setter Property="BorderBrush" Value="#333944" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="CaretBrush" Value="#E6E8EC" />
            <Setter Property="SelectionBrush" Value="#4C8DFF" />
        </Style>

        <!-- The stock ComboBox template paints its own light background regardless of the
             Background/Foreground setters, which makes light-on-light text invisible.
             A full template is required to render it on the dark theme. -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E6E8EC" />
            <Setter Property="Background" Value="#15181F" />
            <Setter Property="BorderBrush" Value="#333944" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="#15181F" BorderBrush="#333944"
                                    BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="8,5,0,5"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                    <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#9AA0A6"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Sits on top so the whole control toggles the popup. -->
                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#1A1D25" BorderBrush="#3A414D" BorderThickness="1"
                                        CornerRadius="4" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4C8DFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E6E8EC" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C3A55" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F6FE4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E8EC" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2F3A" />
            <Setter Property="Foreground" Value="#E6E8EC" />
            <Setter Property="BorderBrush" Value="#3A414D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#353B48" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#2F6FE4" />
            <Setter Property="BorderBrush" Value="#4C8DFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D7DF2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#3A2A2A" />
            <Setter Property="BorderBrush" Value="#5C3A3A" />
            <Setter Property="Foreground" Value="#FFB4B4" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Tr App.Name}" FontSize="19" FontWeight="Bold" />
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedBrush}"
                           FontSize="11.5" Margin="0,3,0,0"
                           Text="{loc:Tr App.Subtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AdminButton" Content="{loc:Tr Toolbar.RestartAdmin}" Style="{StaticResource ToolButton}"
                        Click="AdminButton_Click" />
                <Button Content="{loc:Tr Toolbar.OpenDataDir}" Style="{StaticResource ToolButton}" Click="OpenDataDir_Click" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="7"
                Padding="12,10" Margin="0,14,0,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Tr Toolbar.ModSource}" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="ModSourceText" VerticalAlignment="Center" FontSize="12"
                                   TextTrimming="CharacterEllipsis" MaxWidth="640" />
                        <Border x:Name="ModSourceBadge" CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                Background="#2A3A2A" VerticalAlignment="Center">
                            <TextBlock x:Name="ModSourceBadgeText" FontSize="11" Foreground="#9BD69B" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{loc:Tr Toolbar.Gpu}" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="GpuText" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock x:Name="RouterHintText" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Tr Toolbar.ScanSteam}" Style="{StaticResource ToolButton}" Click="ScanSteam_Click" />
                    <Button Content="{loc:Tr Toolbar.ScanFolder}" Style="{StaticResource ToolButton}" Click="ScanFolder_Click" />
                    <Button Content="{loc:Tr Toolbar.UpdateMod}" Style="{StaticResource ToolButton}"
                            Click="UpdateMod_Click" Margin="0"
                            ToolTip="{loc:Tr Toolbar.UpdateModTip}" />
                    <ComboBox x:Name="LanguageCombo" Width="118" Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              ToolTip="{loc:Tr Toolbar.Language}"
                              SelectionChanged="LanguageCombo_SelectionChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Game list -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="7"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,10,12,8">
                        <TextBlock Text="{loc:Tr List.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:Tr List.Add}" Style="{StaticResource ToolButton}" Padding="9,4"
                                    FontSize="12" Margin="0,0,6,0" Click="AddGame_Click"
                                    ToolTip="{loc:Tr List.AddTip}" />
                            <Button Content="{loc:Tr List.Remove}" Style="{StaticResource ToolButton}" Padding="9,4"
                                    FontSize="12" Margin="0" Click="RemoveGame_Click" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="GameList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             Margin="6,0,6,6" SelectionChanged="GameList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,9">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#252A33" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2C3A55" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                            Background="{Binding StatusColor}" VerticalAlignment="Top" Margin="0,5,9,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{Binding StatusColor}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                                   Foreground="#6E7681" TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Detail -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="7"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,16,14">
                    <StackPanel>
                        <TextBlock x:Name="NoSelectionText" Text="{loc:Tr List.Empty}"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,20,0,0" />

                        <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                            <Border x:Name="AntiCheatBanner" Background="#3A2A1A" BorderBrush="#6B4A1A"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12"
                                    Visibility="{Binding ShowAntiCheatBanner, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding AntiCheatTitle}" FontWeight="SemiBold"
                                               Foreground="#FFC46B" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding AntiCheatBody}" Foreground="#D9B98A"
                                               FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{loc:Tr Detail.GroupGame}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Tr Detail.Name}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Tr Detail.RenderDir}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding RenderDir, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="{loc:Tr Common.Browse}" Style="{StaticResource ToolButton}"
                                        Margin="8,0,4,0" Click="BrowseRenderDir_Click" />
                                <Button Grid.Column="3" Content="{loc:Tr Detail.Detect}" Style="{StaticResource ToolButton}"
                                        Margin="0" Click="DetectRenderDir_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Tr Detail.ExePath}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding ExePath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="{loc:Tr Common.Browse}" Style="{StaticResource ToolButton}"
                                        Margin="8,0,0,0" Click="BrowseExe_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Tr Detail.ProxyEntry}" Style="{StaticResource FieldLabel}" />
                                <!-- Tag carries the stable value the code compares against; Content is
                                     the localised label. Binding SelectedValue to Content would break
                                     as soon as the UI language changed. -->
                                <ComboBox x:Name="ProxyCombo" Grid.Column="1" SelectedValuePath="Tag"
                                          SelectionChanged="ProxyCombo_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Tr Common.Auto}" Tag="自动" />
                                    <ComboBoxItem Content="version.dll" Tag="version.dll" />
                                    <ComboBoxItem Content="winmm.dll" Tag="winmm.dll" />
                                    <ComboBoxItem Content="dinput8.dll" Tag="dinput8.dll" />
                                    <ComboBoxItem Content="winhttp.dll" Tag="winhttp.dll" />
                                    <ComboBoxItem Content="dxgi.dll" Tag="dxgi.dll" />
                                </ComboBox>
                            </Grid>

                            <TextBlock Text="{loc:Tr Detail.ProxyNote}"
                                       Foreground="#6E7681" FontSize="11" TextWrapping="Wrap" Margin="88,0,0,12" />

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,4,0,4" />

                            <TextBlock Text="{loc:Tr Detail.GroupFg}" Style="{StaticResource SectionTitle}" Margin="0,8,0,6" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Tr Detail.Router}" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" SelectedValuePath="Content" Margin="0,0,14,0"
                                          SelectedValue="{Binding Profile.Router, Mode=TwoWay}">
                                    <ComboBoxItem Content="SM86" />
                                    <ComboBoxItem Content="SM75" />
                                </ComboBox>
                                <TextBlock Grid.Column="2" Text="{loc:Tr Detail.KernelImage}" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="3" Width="150" SelectedValuePath="Content"
                                          SelectedValue="{Binding Profile.KernelImage, Mode=TwoWay}">
                                    <ComboBoxItem Content="PTX" />
                                    <ComboBoxItem Content="Auto" />
                                    <ComboBoxItem Content="Cubin" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Tr Detail.MaxFrames}" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="FrameCombo" Grid.Column="1" Margin="0,0,14,0"
                                          DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectedValue="{Binding Profile.MaxGeneratedFrames, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{loc:Tr Detail.LogLevel}" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="LogCombo" Grid.Column="3" Width="150"
                                          DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectedValue="{Binding Profile.LogLevel, Mode=TwoWay}" />
                            </Grid>

                            <CheckBox Content="{loc:Tr Detail.HardwareBilinear}"
                                      IsChecked="{Binding Profile.HardwareBilinear, Mode=TwoWay}" Margin="88,2,0,8" />
                            <CheckBox Content="{loc:Tr Detail.Diagnostics}"
                                      IsChecked="{Binding Profile.Diagnostics, Mode=TwoWay}" Margin="88,0,0,4" />

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,4" />

                            <TextBlock Text="{loc:Tr Detail.GroupActions}" Style="{StaticResource SectionTitle}" Margin="0,8,0,6" />

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="DeployButton" Content="{loc:Tr Action.Deploy}" Style="{StaticResource PrimaryButton}"
                                            Click="Deploy_Click" />
                                    <Button x:Name="RestoreButton" Content="{loc:Tr Action.Restore}" Style="{StaticResource DangerButton}"
                                            Click="Restore_Click" />
                                    <Button x:Name="AdoptButton" Content="{loc:Tr Action.Adopt}" Style="{StaticResource ToolButton}"
                                            Click="Adopt_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{loc:Tr Action.Check}" Style="{StaticResource ToolButton}" Click="Check_Click" />
                                    <Button Content="{loc:Tr Action.OpenDir}" Style="{StaticResource ToolButton}" Click="OpenRenderDir_Click" />
                                    <Button Content="{loc:Tr Action.Launch}" Style="{StaticResource ToolButton}" Click="Launch_Click" />
                                    <Button x:Name="OpenLogButton" Content="{loc:Tr Action.ViewLog}" Style="{StaticResource ToolButton}"
                                            Click="OpenModLog_Click" Margin="0" />
                                </StackPanel>
                                <CheckBox x:Name="RemoveLogsCheck" Content="{loc:Tr Action.RemoveLogs}"
                                          IsChecked="False" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="11,9" Margin="0,14,0,0"
                                    x:Name="StatusCard">
                                <StackPanel>
                                    <TextBlock x:Name="StatusTitle" FontWeight="SemiBold" />
                                    <TextBlock x:Name="StatusBody" Foreground="{StaticResource MutedBrush}"
                                               FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Batch bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,10">
            <Button Content="{loc:Tr Action.DeployAll}" Style="{StaticResource ToolButton}" Click="DeployAll_Click" />
            <Button Content="{loc:Tr Action.RestoreAll}" Style="{StaticResource DangerButton}" Click="RestoreAll_Click" />
            <Button Content="{loc:Tr Action.RefreshAll}" Style="{StaticResource ToolButton}" Click="RefreshAll_Click" />
            <TextBlock x:Name="BatchStatusText" VerticalAlignment="Center" Margin="6,0,0,0"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" />
        </StackPanel>

        <!-- Log -->
        <Border Grid.Row="4" Background="#0E1015" CornerRadius="7"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,8,12,4">
                    <TextBlock Text="{loc:Tr Action.Output}" FontWeight="SemiBold" FontSize="12" Foreground="#B9C0CC" />
                    <Button Content="{loc:Tr Action.Clear}" HorizontalAlignment="Right" Padding="9,3" FontSize="11"
                            Style="{StaticResource ToolButton}" Click="ClearLog_Click" />
                </Grid>
                <TextBox x:Name="OutputBox" Grid.Row="1" Margin="8,0,8,8" IsReadOnly="True"
                         Background="#0E1015" BorderThickness="0" Foreground="#C6CDD8"
                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11.5"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         IsUndoEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
